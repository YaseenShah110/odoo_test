<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Convenience action: the standard Product list/form/kanban views,
        pre-filtered to the Laptops category. No custom views are defined
        here - reusing Odoo's own product views keeps pricing, inventory,
        variants, and website publishing fully working out of the box.
    -->
    <record id="action_laptop_products" model="ir.actions.act_window">
        <field name="name">Laptops</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain" eval="[('categ_id', '=', ref('product_category_laptops'))]"/>
        <field name="context" eval="{
            'default_categ_id': ref('product_category_laptops'),
            'default_public_categ_ids': [ref('product_public_category_laptops')],
            'default_sale_ok': True,
            'default_is_published': True,
        }"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first laptop
            </p>
            <p>
                Laptops created here appear on the public website, both on
                the curated /laptops page and in the standard Shop, once
                published.
            </p>
        </field>
    </record>

    <!-- Top-level app menu. Named distinctly from the unrelated pre-existing
         "Laptop Store" app (project_1/laptop_store) so the two are never
         confused in the backend menu bar. -->
    <menuitem id="menu_laptop_store_root" name="Laptop Store Website" sequence="60"/>

    <menuitem id="menu_laptop_store_laptop" name="Laptops"
              parent="menu_laptop_store_root"
              action="action_laptop_products"
              sequence="10"/>
</odoo>
