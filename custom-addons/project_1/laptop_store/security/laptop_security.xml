<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_laptop_store" model="ir.module.category">
        <field name="name">Laptop Store</field>
    </record>

    <record id="privilege_laptop_store" model="res.groups.privilege">
        <field name="name">Laptop Store</field>
        <field name="category_id" ref="module_category_laptop_store"/>
    </record>

    <record id="group_laptop_salesperson" model="res.groups">
        <field name="name">Salesperson</field>
        <field name="privilege_id" ref="privilege_laptop_store"/>
    </record>

    <record id="group_laptop_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_laptop_store"/>
        <field name="implied_ids" eval="[(4, ref('group_laptop_salesperson'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
