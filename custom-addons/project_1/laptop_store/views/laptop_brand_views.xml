<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_laptop_brand_list" model="ir.ui.view">
        <field name="name">laptop.brand.list</field>
        <field name="model">laptop.brand</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="country"/>
                <field name="laptop_count"/>
            </list>
        </field>
    </record>

    <record id="view_laptop_brand_form" model="ir.ui.view">
        <field name="name">laptop.brand.form</field>
        <field name="model">laptop.brand</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="country"/>
                        <field name="laptop_count"/>
                    </group>
                    <notebook>
                        <page string="Laptops">
                            <field name="laptop_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="category_id"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_laptop_brand" model="ir.actions.act_window">
        <field name="name">Brands</field>
        <field name="res_model">laptop.brand</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
