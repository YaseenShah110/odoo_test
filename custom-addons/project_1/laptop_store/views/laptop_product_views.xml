<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_laptop_product_list" model="ir.ui.view">
        <field name="name">laptop.product.list</field>
        <field name="model">laptop.product</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="brand_id"/>
                <field name="category_id"/>
                <field name="ram_gb"/>
                <field name="storage_gb"/>
                <field name="price"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_laptop_product_form" model="ir.ui.view">
        <field name="name">laptop.product.form</field>
        <field name="model">laptop.product</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_set_in_stock" type="object" string="Set In Stock"
                            invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_reserve" type="object" string="Reserve"
                            invisible="state != 'in_stock'" class="oe_highlight"/>
                    <button name="action_sell" type="object" string="Sell"
                            invisible="state != 'reserved'" class="oe_highlight"/>
                    <button name="action_return_to_stock" type="object" string="Return to Stock"
                            invisible="state not in ('reserved', 'sold')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_stock,reserved,sold"/>
                </header>
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar"
                           options="{'zoom': True, 'preview_image': 'image_128'}"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="serial_number"/>
                            <field name="brand_id"/>
                            <field name="category_id"/>
                        </group>
                        <group>
                            <field name="processor"/>
                            <field name="ram_gb"/>
                            <field name="storage_gb"/>
                            <field name="price"/>
                        </group>
                    </group>
                    <group string="Sale">
                        <field name="customer_id"/>
                        <field name="sale_date"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_laptop_product_search" model="ir.ui.view">
        <field name="name">laptop.product.search</field>
        <field name="model">laptop.product</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="serial_number"/>
                <field name="brand_id"/>
                <field name="category_id"/>
                <filter string="In Stock" name="filter_in_stock" domain="[('state', '=', 'in_stock')]"/>
                <filter string="Reserved" name="filter_reserved" domain="[('state', '=', 'reserved')]"/>
                <filter string="Sold" name="filter_sold" domain="[('state', '=', 'sold')]"/>
                <separator/>
                <group>
                    <filter string="Brand" name="group_by_brand" context="{'group_by': 'brand_id'}"/>
                    <filter string="Category" name="group_by_category" context="{'group_by': 'category_id'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_laptop_product_kanban" model="ir.ui.view">
        <field name="name">laptop.product.kanban</field>
        <field name="model">laptop.product</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="name"/>
                <field name="brand_id"/>
                <field name="price"/>
                <field name="state"/>
                <field name="image_128"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card d-flex">
                            <field name="image_128" widget="image" class="o_kanban_image me-2"
                                   options="{'img_class': 'o_image_64_contain'}"/>
                            <div>
                                <strong><field name="name"/></strong>
                                <div><field name="brand_id"/></div>
                                <div><field name="price"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_laptop_product" model="ir.actions.act_window">
        <field name="name">Laptops</field>
        <field name="res_model">laptop.product</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_laptop_product_search"/>
    </record>
</odoo>
