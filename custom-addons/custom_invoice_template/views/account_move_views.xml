<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_custom_invoice_button" model="ir.ui.view">
        <field name="name">account.move.form.custom.invoice.download</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_print_pdf'][1]" position="after">
                <button name="action_download_custom_invoice"
                        type="object"
                        string="Download Invoice"
                        icon="fa-download"
                        invisible="state != 'posted' or move_type not in ('out_invoice', 'out_refund')"/>
            </xpath>
        </field>
    </record>
</odoo>
