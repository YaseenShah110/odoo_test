<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shopify_sale_order_list" model="ir.ui.view">
        <field name="name">sale.order.shopify.list</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <list string="Shopify Orders">
                <field name="name"/>
                <field name="date_order"/>
                <field name="partner_id"/>
                <field name="shopify_instance_id"/>
                <field name="shopify_order_id"/>
                <field name="shopify_fulfillment_status"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_shopify_sale_order_form" model="ir.ui.view">
        <field name="name">sale.order.shopify.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_export_to_shopify" type="object" string="Export to Shopify" class="btn-secondary" invisible="shopify_order_id != False"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <group string="Shopify Information" groups="ad_shopify_connector.group_shopify_user">
                    <group>
                        <field name="shopify_instance_id"/>
                        <field name="shopify_order_id"/>
                    </group>
                    <group>
                        <field name="shopify_fulfillment_status"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="action_shopify_sale_order" model="ir.actions.act_window">
        <field name="name">Shopify Orders</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('shopify_instance_id', '!=', False)]</field>
        <field name="view_id" ref="view_shopify_sale_order_list"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_shopify_sale_order_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_shopify_sale_order_form')})]"/>
    </record>
</odoo>
