<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shopify_product_template_list" model="ir.ui.view">
        <field name="name">product.template.shopify.list</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <list string="Shopify Products">
                <field name="name"/>
                <field name="default_code"/>
                <field name="shopify_instance_id"/>
                <field name="shopify_product_id"/>
                <field name="exported_to_shopify"/>
            </list>
        </field>
    </record>

    <record id="view_shopify_product_template_form" model="ir.ui.view">
        <field name="name">product.template.shopify.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_push_to_shopify" type="object" string="Export to Shopify" class="btn-secondary" groups="ad_shopify_connector.group_shopify_user"/>
                    <button name="action_sync_from_shopify" type="object" string="Sync from Shopify" class="btn-secondary" groups="ad_shopify_connector.group_shopify_user" invisible="not shopify_product_id"/>
                </header>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Shopify" name="ad_shopify_connector" groups="ad_shopify_connector.group_shopify_user">
                    <group>
                        <group>
                            <field name="shopify_instance_id"/>
                            <field name="shopify_product_id"/>
                            <field name="shopify_product_tags"/>
                        </group>
                        <group>
                            <field name="exported_to_shopify"/>
                            <field name="shopify_last_exported"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="action_shopify_product_template" model="ir.actions.act_window">
        <field name="name">Shopify Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('shopify_instance_id', '!=', False)]</field>
        <field name="view_id" ref="view_shopify_product_template_list"/>
    </record>

    <record id="action_shopify_sync_products" model="ir.actions.server">
        <field name="name">Sync from Shopify</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
            action = records.action_sync_from_shopify()
        </field>
    </record>
</odoo>
