<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shopify_stock_location_list" model="ir.ui.view">
        <field name="name">stock.location.shopify.list</field>
        <field name="model">stock.location</field>
        <field name="arch" type="xml">
            <list string="Shopify Locations" editable="bottom">
                <header>
                    <button name="action_export_stock" type="object" string="Sync Stock to Shopify" class="btn-primary"/>
                </header>
                <field name="complete_name"/>
                <field name="shopify_instance_id"/>
                <field name="shopify_location_id"/>
            </list>
        </field>
    </record>

    <record id="action_shopify_location" model="ir.actions.act_window">
        <field name="name">Shopify Locations</field>
        <field name="res_model">stock.location</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('shopify_instance_id', '!=', False)]</field>
        <field name="view_id" ref="view_shopify_stock_location_list"/>
    </record>
</odoo>
