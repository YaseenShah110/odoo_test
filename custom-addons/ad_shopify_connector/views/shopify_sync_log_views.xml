<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shopify_sync_log_list" model="ir.ui.view">
        <field name="name">shopify.sync.log.list</field>
        <field name="model">shopify.sync.log</field>
        <field name="arch" type="xml">
            <list string="Sync Logs" decoration-success="state == 'success'"
                  decoration-warning="state == 'partial'"
                  decoration-danger="state == 'error'">
                <field name="create_date" string="Date"/>
                <field name="instance_id"/>
                <field name="sync_type"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'success'"
                       decoration-warning="state == 'partial'"
                       decoration-danger="state == 'error'"/>
                <field name="records_processed"/>
                <field name="records_failed"/>
                <field name="message"/>
            </list>
        </field>
    </record>

    <record id="view_shopify_sync_log_search" model="ir.ui.view">
        <field name="name">shopify.sync.log.search</field>
        <field name="model">shopify.sync.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="instance_id"/>
                <field name="sync_type"/>
                <filter name="filter_success" string="Success" domain="[('state','=','success')]"/>
                <filter name="filter_error" string="Errors" domain="[('state','=','error')]"/>
                <group>
                    <filter name="group_instance" string="Instance" context="{'group_by': 'instance_id'}"/>
                    <filter name="group_type" string="Sync Type" context="{'group_by': 'sync_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_shopify_sync_log" model="ir.actions.act_window">
        <field name="name">Sync Logs</field>
        <field name="res_model">shopify.sync.log</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_shopify_sync_log_list"/>
    </record>
</odoo>
