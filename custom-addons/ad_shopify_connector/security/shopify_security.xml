<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_ad_shopify_connector" model="ir.module.category">
        <field name="name">Shopify Connector</field>
        <field name="description">Helps you manage Shopify integration.</field>
        <field name="sequence">20</field>
    </record>

    <record model="res.groups.privilege" id="res_groups_privilege_shopify">
        <field name="name">Shopify Connector</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="module_category_ad_shopify_connector"/>
    </record>

    <record id="group_shopify_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_shopify"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_shopify_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="res_groups_privilege_shopify"/>
        <field name="implied_ids" eval="[(4, ref('group_shopify_user'))]"/>
    </record>


    <record id="shopify_instance_multi_company_rule" model="ir.rule">
        <field name="name">Shopify Instance: Multi-Company</field>
        <field name="model_id" ref="model_shopify_instance"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
